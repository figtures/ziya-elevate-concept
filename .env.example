# Optional build-only override. Usually use `npm run domain:configure` instead,
# which also synchronizes Supabase Auth and exact-origin CORS.
# SITE_URL=https://your-domain.example

# Supply SUPABASE_ACCESS_TOKEN only in the operator's shell for domain:configure --apply.
# Never commit the token or expose it as a public/browser environment variable.

# Required secret RUNTIME variable for owner-managed account creation (never public).
# SUPABASE_SERVICE_ROLE_KEY=
